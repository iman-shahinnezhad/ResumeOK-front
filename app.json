{
  "expo": {
    "name": "ApplyDesk",
    "slug": "resumeok",
    "version": "2.1.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "applydesk",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixflow.applydesk",
      "buildNumber": "52",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to select a profile photo to be embedded directly into your generated resume templates.",
        "NSCameraUsageDescription": "This app requires access to your camera to take a photo to use as a profile picture on your generated resume templates.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B192F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 8,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.pixflow.applydesk"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "icon1": {
            "ios": "./assets/images/icon1.png",
            "android": "./assets/images/icon1.png"
          },
          "icon2": {
            "ios": "./assets/images/icon2.png",
            "android": "./assets/images/icon2.png"
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos or documents to let you choose files for ApplyDesk.",
          "cameraPermission": "The app needs to access your camera to let you take a photo for ApplyDesk."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f71680bd-b86e-4ad1-8214-87bcc22a01f5"
      }
    },
    "owner": ""
  }
}
