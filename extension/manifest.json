{
  "manifest_version": 3,
  "name": "ApplyDesk - Auto Apply & Resume Tailor",
  "version": "2.1.3",
  "description": "1-Click ATS Job Application Autofill, Real-time Match Analyzer, AI Q&A Copilot, and Application Tracker.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://applydesk.io/*",
    "https://*.applydesk.io/*",
    "https://applydesk.app/*",
    "https://*.applydesk.app/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workday.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.taleo.net/*",
    "*://*.smartrecruiters.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.rippling.com/*",
    "*://*.bamboohr.com/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://188.166.164.115/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://applydesk.io/*",
        "https://*.applydesk.io/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.taleo.net/*",
        "*://*.smartrecruiters.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.rippling.com/*",
        "*://*.bamboohr.com/*",
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "<all_urls>"
      ],
      "js": ["content/content-script.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/*",
        "popup/*",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
