{
  "manifest_version": 3,
  "name": "ApplyDesk - Auto Apply & Resume Tailor",
  "version": "2.1.1",
  "description": "1-Click ATS Job Application Autofill, Real-time Match Analyzer, AI Q&A Copilot, and Application Tracker.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workday.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.taleo.net/*",
    "*://*.smartrecruiters.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.rippling.com/*",
    "*://*.bamboohr.com/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://188.166.164.115/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.taleo.net/*",
        "*://*.smartrecruiters.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.rippling.com/*",
        "*://*.bamboohr.com/*",
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "<all_urls>"
      ],
      "js": ["content/content-script.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
